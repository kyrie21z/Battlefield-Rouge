extends SceneTree
const Flow = preload("res://ui/pride_opening/opening_flow.gd")
const DATA = preload("res://ui/pride_opening/dialogue.json")
var checks: int = 0
var failures: int = 0

func check(condition: bool, message: String) -> void:
	checks += 1
	if not condition:
		failures += 1
		push_error(message)

func _initialize() -> void:
	check(DATA.data.mode == "click_to_advance", "Reading has no fixed duration")
	check(DATA.data.shots.size() == 5, "Five concise dialogue beats")
	for shot in DATA.data.shots:
		check(not str(shot.line).is_empty(), "Each beat has readable dialogue")
		check(str(shot.line).length() <= 32, "Dialogue fits a short reading beat")
		check(shot.position.size() == 3, "Every beat has a flight destination")
	check(str(DATA.data.objective).contains("Sloth"), "Skipping retains the objective")
	check(str(DATA.data.direction).contains("入口"), "Skipping retains direction")
	var flow := Flow.new()
	flow.step_count = DATA.data.shots.size()
	check(flow.state == Flow.State.TITLE and not flow.can_move(), "Title is safe")
	flow.confirm()
	flow.enter()
	check(flow.state == Flow.State.TITLE and flow.entry_count == 0, "Invalid actions cannot enter")
	flow.start()
	flow.tick(90)
	check(flow.step_index == 0 and flow.state == Flow.State.CINEMATIC, "Waiting never auto-advances dialogue")
	flow.advance()
	check(flow.step_index == 1 and flow.step_elapsed == 0, "Next sentence is immediate")
	flow.advance()
	check(flow.step_index == 2, "Fast clicks do not require an animation to finish")
	flow.toggle_pause()
	flow.tick(30)
	flow.advance()
	check(flow.step_index == 2 and flow.step_elapsed == 0, "Pause freezes dialogue and motion time")
	flow.toggle_pause()
	flow.advance()
	flow.advance()
	check(flow.step_index == 4 and flow.state == Flow.State.CINEMATIC, "Last sentence still needs acknowledgement")
	flow.advance()
	check(flow.state == Flow.State.DECISION and not flow.accepted, "Finishing dialogue never auto-confirms departure")
	flow.observe()
	check(flow.state == Flow.State.OBSERVING and flow.can_move(), "Observe gives movement")
	flow.enter()
	check(flow.entry_count == 0, "Observation cannot accidentally enter combat")
	flow.toggle_pause()
	check(not flow.can_move(), "Pause stops observation movement")
	flow.decision()
	check(flow.state == Flow.State.OBSERVING, "Paused input does not change choice")
	flow.toggle_pause()
	for i in range(3):
		flow.decision()
		check(flow.state == Flow.State.DECISION, "Observation has a reliable return")
		flow.observe()
	flow.decision()
	flow.confirm()
	check(flow.state == Flow.State.WALKING and not flow.can_move() and flow.accepted, "Confirmation starts a brief automatic handoff")
	flow.toggle_pause()
	flow.enter()
	check(flow.entry_count == 0, "Paused game cannot enter")
	flow.toggle_pause()
	flow.enter()
	flow.enter()
	check(flow.state == Flow.State.COMPLETE and flow.entry_count == 1, "Entry fires once")
	check(flow.can_move(), "Control returns inside the first room")
	flow.start()
	check(not flow.accepted and not flow.paused and flow.entry_count == 0 and flow.step_index == 0, "Replay resets state")
	flow.advance()
	flow.skip()
	check(flow.skipped and flow.state == Flow.State.DECISION and not flow.can_move(), "Mid-line skip gives a readable briefing")
	flow.observe()
	flow.decision()
	flow.confirm()
	flow.enter()
	check(flow.entry_count == 1, "Skip path can complete")
	flow.start()
	flow.toggle_pause()
	flow.skip()
	check(not flow.paused and flow.state == Flow.State.DECISION, "Skip cleans pause state")
	var fresh := Flow.new()
	fresh.skip()
	check(fresh.state == Flow.State.DECISION and fresh.skipped, "Direct start retains briefing")
	print("FLOW TEST: ", checks, " checks, ", failures, " failures")
	quit(0 if failures == 0 else 1)
